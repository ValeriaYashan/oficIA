---
import Base from '../layouts/Base.astro';
---
<Base titulo="Página no encontrada | OficIA" descripcion="La página que buscás no existe.">
  <section class="seccion vacia-pag">
    <div class="wrap">
      <p class="eyebrow">Error 404</p>
      <h1>No encontramos esa página</h1>
      <p class="lead" style="margin-inline:auto">Puede que el enlace haya cambiado. Volvé al inicio o mirá los cursos.</p>
      <p style="margin-top:24px"><a class="btn btn-primario" href="/">Ir al inicio</a> <a class="btn btn-borde" href="/cursos">Ver cursos</a></p>
    </div>
  </section>
</Base>
